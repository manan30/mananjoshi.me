---
import { getDashboardArticles } from "../../services/contentful";
import SectionHeader from "./SectionHeader.astro";

const articlesData = await getDashboardArticles();
---

<SectionHeader title='Articles' link='articles' />
<div class='mt-5 overflow-hidden rounded-2xl border border-white/10 bg-slate-900/50'>
  {
    articlesData.map(({ fields: article }) => (
      <article class='border-b border-white/10 p-4 last:border-b-0 sm:p-5'>
        <a href={`articles/${article.slug}`} class='group block'>
          <h4 class='text-base font-semibold text-slate-100 transition group-hover:text-orange-300 md:text-lg'>
            {article.title}
          </h4>
          <div class='mt-2 flex items-center gap-2 text-xs text-slate-400'>
            <span>{article.readTime} min read</span>
            <span aria-hidden='true'>•</span>
            <span>Article</span>
          </div>
        </a>
      </article>
    ))
  }
</div>
