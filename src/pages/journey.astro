---
import { documentToHtmlString } from "@contentful/rich-text-html-renderer";
import BaseLayout from "../layouts/BaseLayout.astro";

import type { IconType } from "../components/Icon";
import { Icon } from "../components/Icon";
import { getJourneyData } from "../services/contentful/journeyData";

const journeyData = await getJourneyData();
---

<BaseLayout title='Work'>
  <section class='reveal mt-8'>
    <p class='text-xs font-semibold uppercase tracking-[0.24em] text-orange-300'>
      Career
    </p>
    <h1 class='mt-2 text-[2rem] font-semibold text-slate-100 sm:text-4xl md:text-6xl'>Journey</h1>
  </section>

  <ol class='reveal relative mt-8 border-l border-white/15 pl-2'>
    {
      journeyData.map((journey) => (
        <li class='mb-8 ml-6'>
          <span class='absolute -left-[11px] flex h-5 w-5 items-center justify-center rounded-full bg-orange-500 ring-4 ring-slate-950'>
            <Icon icon={journey.type[0].toLowerCase() as IconType}/>
          </span>
          <div class='flex flex-col space-y-2'>
            <h3 class='flex items-center text-lg font-semibold text-slate-100'>
              {journey.title} @ {journey.company}
            </h3>
            <p class='mb-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-normal leading-none text-slate-400'>
              <span>
                {Intl.DateTimeFormat('en-US', {
                  month: 'short',
                  year: '2-digit'
                })
                  .formatToParts(new Date(journey.startDate))
                  .map((p) => {
                    if (p.type === 'literal') {
                      return " '";
                    }
                    return p.value;
                  })
                  .join('')}{' '}
                -{' '}
                {journey.endDate
                  ? Intl.DateTimeFormat('en-US', {
                      month: 'short',
                      year: '2-digit'
                    })
                      .formatToParts(new Date(journey.endDate))
                      .map((p) => {
                        if (p.type === 'literal') {
                          return " '";
                        }
                        return p.value;
                      })
                      .join('')
                  : 'Present'}
              </span>
              <svg height='8' width='8' class='fill-current text-slate-500'>
                <circle cx='4' cy='4' r='2' />
              </svg>
              <span>{journey.location}</span>
            </p>
          </div>
          <span
            class='prose prose-sm prose-li:p-0 prose-ul:pl-0 prose-li:list-none font-normal text-slate-200 prose-a:text-orange-200 prose-strong:text-slate-100'
            set:html={documentToHtmlString(journey.duties)}
          />
        </li>
      ))
    }
  </ol>
</BaseLayout>
